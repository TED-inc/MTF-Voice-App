<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ScottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1500" d:DesignHeight="700"
        x:Class="MTFVoiceTools.MainWindow"
        Title="MTFVoiceTools">
    <Grid RowDefinitions="Auto,*" Margin="10">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Button Grid.Column="0" Click="ClickHandler">Next Frame</Button>
            <TextBlock Grid.Column="1" Margin="0 10" x:Name="Message" TextWrapping="Wrap">Lorem ipsumS mollis. Donec viverra ante eget ipsum consectetur sollicitudin. Quisque auctor egestas neque. Vivamus dictum ex congue, facilisis mi a, dapibus augue.
            </TextBlock>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,500">
            <ScottPlot:AvaPlot Grid.Column="0" x:Name="SignalPlot"/>
            <ScottPlot:AvaPlot Grid.Column="1" x:Name="VowelPlot"/>
        </Grid>
    </Grid>
</Window>
